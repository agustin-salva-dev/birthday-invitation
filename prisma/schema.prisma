generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guest {
  id         String      @id @default(cuid())
  name       String
  status     GuestStatus @default(PENDING)
  companions Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status])
  @@index([name])
}

enum GuestStatus {
  PENDING
  CONFIRMED
  DECLINED
}
